# Host/IP do banco Oracle.
# Exemplo: IP do servidor Oracle na rede interna.
DATABASE_HOST=172.19.0.250

# Usuario usado pelo dashboard para conectar no Oracle.
# Exemplo: usuario tecnico com permissao de leitura/escrita nas tabelas do sistema.
DATABASE_USER=bpuser

# Senha do usuario Oracle acima.
# Exemplo: troque pelo valor real do ambiente.
PASSWORD=sua_senha_aqui

# Porta TCP do Oracle.
# Normalmente 1521.
DATABASE_PORT=1521

# Service name do Oracle.
# Exemplo: nome do servico publicado pela instancia.
DATABASE_SERVICE=prdamevo

# Schema onde estao as tabelas do sistema.
# Exemplo: schema proprietario das tabelas.
DATABASE_SCHEMA=dbasistemas

# Endereco do alert_server visto pelo dashboard.
# Em Docker Compose, o valor recomendado e o nome do servico.
# Exemplo: alert_server
SERVER_IP=alert_server

# Porta HTTP do alert_server.
# O dashboard usa isso para health check e integracao com o servidor principal.
SERVER_PORT=9600

# Porta exposta do dashboard web no host Linux.
# Exemplo: acessar http://localhost:3303
DASHBOARD_PORT=3303

# Caminho do Oracle Instant Client dentro do container.
# No setup Docker deste projeto, esse valor deve apontar para o volume montado.
ORACLE_CLIENT_LIB_DIR=/opt/oracle/instantclient

# Caminho do executavel Windows do botao dentro do container.
# O dashboard usa isso ao copiar/instalar o cliente via SMB.
PATH_EXE_BOTAO=/app/dist/botao_de_enviar.exe

# Caminho do executavel Windows do receptor dentro do container.
# O dashboard usa isso ao instalar o receptor via SMB.
PATH_RECEPTOR=/app/dist/BotaoPanico_Receptor.exe

# Servidor DNS usado em algumas operacoes de rede/AD.
# Exemplo: DNS interno da empresa.
DNS_SERVER=172.19.0.10

# Chave secreta do Flask/dashboard.
# Use um valor longo e aleatorio.
SECRET_KEY=troque-por-uma-chave-secreta-longa-e-unica
